VITE_FIREBASE_VAPID_KEY=YOUR_WEB_PUSH_CERTIFICATE_KEY_PAIR

# Optional App Check (reCAPTCHA v3 site key — Firebase Console → App Check → Web app)
# Leave empty to run without App Check (fine for local dev).
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Local dev only: debug token from Firebase Console → App Check → Manage debug tokens
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=
