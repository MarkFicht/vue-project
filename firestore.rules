rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRequiredUserKeys(data) {
      return data.keys().hasAll([
        'uid',
        'email',
        'displayName',
        'displayNameKey',
        'game',
        'readyToGame',
        'status',
        'timestamp',
        'createdAt',
        'updatedAt',
        'lastSeenAt',
        'schemaVersion',
        'soundMuted'
      ]);
    }

    function userDocShapeIsValid(data, userId) {
      return data.uid == userId
        && data.uid is string
        && data.email is string
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayNameKey is string
        && data.displayNameKey.size() > 0
        && data.game is string
        && data.readyToGame is bool
        && (data.status in ['online', 'away', 'offline'])
        && data.schemaVersion is int
        && data.soundMuted is bool;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && hasRequiredUserKeys(request.resource.data)
        && userDocShapeIsValid(request.resource.data, userId);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /displayNames/{displayNameKey} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/displayNames/$(displayNameKey))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /gameStatus/{docId} {
      allow read, write: if isSignedIn();
    }

    match /gameDuel/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
